# n8n AI Stack — environment template
#
# Copy to `.env` alongside docker-compose.yml on VM 105 and fill in real values.
# `.env` is blocked by .gitignore. This file must never contain real values.
#
# Master copies of every value below live in Bitwarden. See README.md §5.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=CHANGEME

# --- n8n credential encryption ------------------------------------------
# CRITICAL. Encrypts every credential stored in the database.
#
# If this value is lost or changed, every credential in n8n becomes
# permanently undecryptable — a database backup alone will NOT restore this
# service. Workflows return intact and completely non-functional.
#
# Bitwarden: "n8n encryption key — VM 105"
#
# When migrating an existing install, this MUST be the original value.
N8N_ENCRYPTION_KEY=CHANGEME

# --- addressing ---------------------------------------------------------
N8N_HOST=n8n.leonshomelab.internal
WEBHOOK_URL=https://n8n.leonshomelab.internal/
